# Copy to .env before running. Never commit real secrets.
APP_MODE=cli
USE_IN_MEMORY=false
DATABASE_URL=
# Required with DATABASE_URL; generate 32 random bytes as canonical base64.
WHATSAPP_RECIPIENT_ENCRYPTION_KEY_BASE64=
# Optional overlap key ring for rotation: {"active_key_id":"k-new","keys":{"k-old":"<base64>","k-new":"<base64>"}}.
# Keep at most 8 keys; every value is 32 random bytes as canonical base64.
WHATSAPP_RECIPIENT_ENCRYPTION_KEYS_JSON=
# Required for the single-tenant database runtime unless an injected tenant registry is supplied.
TENANT_ID=
PG_STATEMENT_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000
PG_TRANSACTION_TIMEOUT_MS=10000
PG_APPLICATION_NAME=sela-appointment-agent
PG_POOL_MAX=10
# Database-backed mode requires 1-500 bounded slots with a stable resources.id.
# Example: [{"id":"slot-1","start_iso":"2026-10-01T09:00:00.000Z","end_iso":"2026-10-01T09:30:00.000Z","staff":"provider-7","resource_id":"7"}]
CALENDAR_SLOTS_JSON=
INBOUND_MESSAGE_RETENTION_DAYS=30
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
WORKER_BATCH_SIZE=10
HOST=0.0.0.0
PORT=3000
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Per-tenant Meta sender credentials for database-backed mode.
# The process-global WHATSAPP_API_TOKEN/WHATSAPP_PHONE_NUMBER_ID fallback does
# not apply with DATABASE_URL; each tenant needs an explicit mapping entry.
# Example: {"42":{"phone_number_id_ref":"WHATSAPP_TENANT_42_PHONE_NUMBER_ID","access_token_ref":"WHATSAPP_TENANT_42_API_TOKEN"}}
WHATSAPP_TENANT_SENDER_REFS_JSON=
WHATSAPP_TENANT_42_PHONE_NUMBER_ID=
WHATSAPP_TENANT_42_API_TOKEN=
# Use `memory` only for local/test; production defaults to Meta.
WHATSAPP_TRANSPORT=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_REQUEST_TIMEOUT_MS=10000
FIRECRAWL_API_URL=http://localhost:3002
HOLD_TTL_SECONDS=300
CONFIDENCE_THRESHOLD=0.7
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama-local-dummy
LLM_MODEL=llama3.1
# Tenant-scoped fixed-window limits. Keep values below the account's verified Meta throughput.
RATE_LIMIT_WEBHOOK_MAX_REQUESTS=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
RATE_LIMIT_OUTBOUND_MAX_REQUESTS=60
RATE_LIMIT_OUTBOUND_WINDOW_SECONDS=60
RATE_LIMIT_OPERATOR_MAX_REQUESTS=60
RATE_LIMIT_OPERATOR_WINDOW_SECONDS=60
OUTBOUND_PROVIDER=whatsapp
# Database production gate; recovery evidence is supplied by the operator, never guessed.
DATABASE_GATE_REQUIRE_TLS=true
DATABASE_BACKUP_VERIFIED_AT=
DATABASE_BACKUP_REFERENCE=
DATABASE_RESTORE_TESTED_AT=
DATABASE_RESTORE_REFERENCE=
# Enterprise OIDC operator API (inject a verifier in production; never paste tokens here).
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
# Supabase Auth IdP alternative (owner decision, Sept 2026): fill with the
# project's own issuer URL, HTTPS JWKS URL, and audience. All empty by
# default; the verifier fails closed until a complete triple is configured.
# Never commit a real project URL or key.
SUPABASE_AUTH_ISSUER_URL=
SUPABASE_AUTH_JWKS_URL=
SUPABASE_AUTH_AUDIENCE=
OIDC_TENANT_ROLES_CLAIM=tenant_roles
# --- Staff authentication (dashboard operator login) ----------------------
# Staff sign-in is an OAuth authorization-code flow. There is NO default: with no
# provider configured the dashboard refuses to render, so local development cannot
# fall back to an unauthenticated workspace.
# Supabase Auth as the OIDC provider. The OAuth client is a separate credential
# from the operator-API bearer audience above; all five values are required
# together and a partial set fails closed.
SUPABASE_AUTH_OAUTH_CLIENT_ID=
SUPABASE_AUTH_OAUTH_CLIENT_SECRET=
# Audience of the ID token. An ID token's audience IS the OAuth client id, so
# this must equal the matching *_OAUTH_CLIENT_ID above; a value that disagrees is
# refused at startup with `oauth_configuration_invalid` rather than ignored.
SUPABASE_AUTH_STAFF_AUDIENCE=
# Google as the identity provider, and optionally the Calendar consent provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ISSUER_URL=https://accounts.google.com
GOOGLE_OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Must equal GOOGLE_OAUTH_CLIENT_ID; see SUPABASE_AUTH_STAFF_AUDIENCE above.
GOOGLE_OAUTH_STAFF_AUDIENCE=
# Optional Workspace hosted domain. When set, a Google ID token without a
# matching `hd` claim is rejected, which restricts sign-in to the tenant's own
# Workspace accounts. Leave empty to allow any Google account the directory knows.
GOOGLE_WORKSPACE_HOSTED_DOMAIN=
# Absolute callback URIs. Every one must appear in the allow-list below; a
# callback that is not on the list is refused rather than reflected.
STAFF_AUTH_LOGIN_REDIRECT_URI=
STAFF_AUTH_CALENDAR_REDIRECT_URI=
# JSON array or comma-separated list of permitted redirect URIs. Required.
STAFF_AUTH_REDIRECT_ALLOW_LIST=
# Origin the dashboard is served from, and the only origin post-credential
# redirects are built from — the request's Host header is never trusted for them.
# An https origin makes the session cookie `Secure` with a `__Host-` prefix. An
# http origin is refused unless it is a loopback address AND the opt-in below is
# set to true. The dashboard also refuses to start on a non-loopback origin while
# it is using the in-memory state, session, and grant stores, because a second
# instance would not see a login state or a revocation issued by the first.
STAFF_AUTH_PUBLIC_BASE_URL=
STAFF_AUTH_ALLOW_INSECURE_LOOPBACK=false
# Session lifetime in seconds (300-86400).
STAFF_AUTH_SESSION_TTL_SECONDS=3600
# Staff membership directory: which tenants a verified subject may act in.
# Entries: [{"issuer":"...","subject_id":"...","org_id":"...","tenant_id":"1001",
# "roles":["owner"],"status":"active","invited_at_iso":"...","updated_at_iso":"..."}]
# Only `status: "active"` grants roles, so a suspended or revoked member cannot
# obtain a session. Empty means every login fails closed.
STAFF_DIRECTORY_JSON=
# HMAC key for operator-action authorization receipts; canonical base64 of 32
# random bytes. Without it every operator action is denied.
STAFF_ACTION_RECEIPT_KEY_BASE64=
# Optional Calendar scopes requested during consent.
STAFF_AUTH_CALENDAR_SCOPES_JSON=
# Google Calendar refresh tokens reuse the recipient key ring above so no new key
# material is introduced; they are sealed per tenant and per purpose, so a row
# copied to another tenant fails to decrypt.
# Explicit DR objectives/evidence.
DR_RPO_MINUTES=
DR_RTO_MINUTES=
DR_BACKUP_REFERENCE=
DR_RESTORE_TESTED_AT=
DR_REGION=
# Live Meta smoke is opt-in and must target a staging tenant/WABA.
META_SMOKE_MODE=preflight
META_SMOKE_ENVIRONMENT=
META_SMOKE_GRAPH_API_URL=https://graph.facebook.com/v23.0
META_SMOKE_ALLOW_SEND=false
META_SMOKE_RECIPIENT_E164=
META_SMOKE_TEMPLATE_NAME=
META_SMOKE_TEMPLATE_LANGUAGE=en_US
# Approved utility templates (fail-closed; template sends are blocked until at
# least one non-promotional utility entry is recorded with language/category).
# Example: [{"name":"appointment_reminder","language":"en_US","category":"utility"}]
WHATSAPP_APPROVED_TEMPLATES_JSON=

# --- Optional LLM intent classifier -------------------------------------
# Disabled by default: with no provider selected the agent runs its regex
# fast path and hands off on ambiguity, exactly as before. Values are
# placeholders only; never commit a real key.
# Provider: anthropic | gemini | openai. The named provider is never silently
# replaced by another vendor if its key is missing.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
