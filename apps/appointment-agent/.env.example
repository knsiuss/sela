# Copy to .env before running. Never commit real secrets.
APP_MODE=cli
USE_IN_MEMORY=false
DATABASE_URL=
# Required with DATABASE_URL; generate 32 random bytes as canonical base64.
WHATSAPP_RECIPIENT_ENCRYPTION_KEY_BASE64=
# Optional overlap key ring for rotation: {"active_key_id":"k-new","keys":{"k-old":"<base64>","k-new":"<base64>"}}.
# Keep at most 8 keys; every value is 32 random bytes as canonical base64.
WHATSAPP_RECIPIENT_ENCRYPTION_KEYS_JSON=
# Required for the single-tenant database runtime unless an injected tenant registry is supplied.
TENANT_ID=
PG_STATEMENT_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000
PG_TRANSACTION_TIMEOUT_MS=10000
PG_APPLICATION_NAME=sela-appointment-agent
PG_POOL_MAX=10
INBOUND_MESSAGE_RETENTION_DAYS=30
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
WORKER_BATCH_SIZE=10
HOST=0.0.0.0
PORT=3000
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Per-tenant Meta sender credentials for database-backed mode.
# The process-global WHATSAPP_API_TOKEN/WHATSAPP_PHONE_NUMBER_ID fallback does
# not apply with DATABASE_URL; each tenant needs an explicit mapping entry.
# Example: {"42":{"phone_number_id_ref":"WHATSAPP_TENANT_42_PHONE_NUMBER_ID","access_token_ref":"WHATSAPP_TENANT_42_API_TOKEN"}}
WHATSAPP_TENANT_SENDER_REFS_JSON=
WHATSAPP_TENANT_42_PHONE_NUMBER_ID=
WHATSAPP_TENANT_42_API_TOKEN=
# Use `memory` only for local/test; production defaults to Meta.
WHATSAPP_TRANSPORT=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_REQUEST_TIMEOUT_MS=10000
FIRECRAWL_API_URL=http://localhost:3002
HOLD_TTL_SECONDS=300
CONFIDENCE_THRESHOLD=0.7
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama-local-dummy
LLM_MODEL=llama3.1
# Live Meta smoke is opt-in and must target a staging tenant/WABA.
META_SMOKE_MODE=preflight
META_SMOKE_ENVIRONMENT=
META_SMOKE_GRAPH_API_URL=https://graph.facebook.com/v23.0
META_SMOKE_ALLOW_SEND=false
META_SMOKE_RECIPIENT_E164=
META_SMOKE_TEMPLATE_NAME=
META_SMOKE_TEMPLATE_LANGUAGE=en_US
# Approved utility templates (fail-closed; template sends are blocked until at
# least one non-promotional utility entry is recorded with language/category).
# Example: [{"name":"appointment_reminder","language":"en_US","category":"utility"}]
WHATSAPP_APPROVED_TEMPLATES_JSON=
