# Copy to .env before running. Never commit real secrets.
APP_MODE=cli
USE_IN_MEMORY=false
DATABASE_URL=
# Required with DATABASE_URL; generate 32 random bytes as canonical base64.
WHATSAPP_RECIPIENT_ENCRYPTION_KEY_BASE64=
PG_STATEMENT_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000
PG_APPLICATION_NAME=sela-appointment-agent
PG_POOL_MAX=10
INBOUND_MESSAGE_RETENTION_DAYS=30
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
WORKER_BATCH_SIZE=10
HOST=0.0.0.0
PORT=3000
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Use `memory` only for local/test; production defaults to Meta.
WHATSAPP_TRANSPORT=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_REQUEST_TIMEOUT_MS=10000
FIRECRAWL_API_URL=http://localhost:3002
HOLD_TTL_SECONDS=300
CONFIDENCE_THRESHOLD=0.7
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama-local-dummy
LLM_MODEL=llama3.1
